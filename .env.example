# Optional native AI credential for development. A nonempty environment value
# overrides the key stored through the desktop OS keychain.
REDROB_API_KEY=

# Optional live integration gates. Export these values in the shell/CI; Cargo
# does not automatically load this file. Use disposable databases and accounts.
REDROB_TEST_POSTGRES_URL=
REDROB_TEST_MYSQL_URL=

# The Mongo suite creates and drops only a uniquely named collection. The test
# database defaults to redrob_test when REDROB_TEST_MONGO_DATABASE is unset.
REDROB_TEST_MONGO_URL=
REDROB_TEST_MONGO_DATABASE=redrob_test
