# There is no Redrob console key here: the shared Redrob Code daemon holds it and
# desktop AI reaches the console only through that daemon (see README, "Redrob AI
# configuration"). REDROB_RUN_DIR and REDROB_CODE_BIN point tests at a private daemon.

# Three live connector tests are #[ignore] by default. Cargo does not load this
# file automatically: export disposable URLs in the shell, then run tests with
# `cargo test --locked -p redrob-core --all-features -- --ignored`.
# An explicitly run gate fails when its required URL is absent.
REDROB_TEST_POSTGRES_URL=
REDROB_TEST_MYSQL_URL=

# The Mongo gate creates and drops only one UUID-named collection. Its database
# defaults to redrob_test when REDROB_TEST_MONGO_DATABASE is unset.
REDROB_TEST_MONGO_URL=
REDROB_TEST_MONGO_DATABASE=redrob_test
